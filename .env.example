# Reference only: supply values through your terminal or provider environment settings.
# This file is not loaded automatically. Never commit a completed file containing secrets.
DATABASE_URL=postgresql+psycopg://USERNAME:ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=require
SECRET_KEY=
CORS_ORIGINS=https://YOUR_WEBSITE_HOST
PUBLIC_API_URL=https://YOUR_API_HOST
PAYMENT_BACKEND=disabled
CONTACT_BACKEND=disabled
# Optional verified HTTPS email provider; enter actual secrets only in hosting settings.
RESEND_API_KEY=
CONTACT_FROM=
# Live payments are deferred. Keep blank/disabled until merchant activation and testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Sample values for review only.
SHIPPING_FEE=49
FREE_SHIPPING_THRESHOLD=999
RATELIMIT_STORAGE_URI=memory://
# Public build-time setting for the website/Android app, not a backend secret.
EXPO_PUBLIC_API_URL=https://YOUR_API_HOST/api/v1
