# Create this database locally before running flask --app backend init-db.
# Set DATABASE_URL in the terminal environment; this file is a template only.
DATABASE_URL=postgresql+psycopg://grove_stone:replace_me@localhost:5432/grove_stone
# Generate once and retain across restarts; at least 32 random characters.
SECRET_KEY=replace_with_a_generated_secret
CORS_ORIGINS=http://localhost:8081
# Default is for one local process. Use shared storage for multiple workers.
RATELIMIT_STORAGE_URI=memory://
# Required delivery pricing: example values for review, approve before launch.
SHIPPING_FEE=49
FREE_SHIPPING_THRESHOLD=999
# demo is restricted to loopback databases ending in _local; disabled is default.
PAYMENT_BACKEND=disabled
CONTACT_BACKEND=disabled
PUBLIC_API_URL=https://YOUR-API.onrender.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPPORT_EMAIL=
SUPPORT_PHONE=
RESEND_API_KEY=
CONTACT_FROM=
# Draft policy window; approve before launch.
QUALITY_REPORT_HOURS=24
# Only needed when explicitly running dispatch-push with Firebase installed.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json
